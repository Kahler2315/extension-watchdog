{
  "manifest_version": 3,
  "name": "Extension Watchdog",
  "version": "0.1.3",
  "description": "Understand extension permissions and review meaningful changes without sending browser data anywhere.",
  "homepage_url": "https://github.com/Kahler2315/extension-watchdog",
  "icons": {
    "16": "icons/watchdog-16.png",
    "32": "icons/watchdog-32.png",
    "48": "icons/watchdog-48.png",
    "96": "icons/watchdog-96.png",
    "128": "icons/watchdog-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "extension-watchdog@kahler2315.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "management",
    "storage",
    "notifications"
  ],
  "background": {
    "scripts": [
      "background/classifier.js",
      "background/background.js"
    ]
  },
  "action": {
    "default_title": "Extension Watchdog",
    "default_icon": {
      "16": "icons/watchdog-16.png",
      "32": "icons/watchdog-32.png",
      "48": "icons/watchdog-48.png",
      "96": "icons/watchdog-96.png"
    },
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "dashboard/index.html",
    "open_in_tab": true
  }
}
