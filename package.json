{
  "name": "extension-watchdog",
  "version": "0.1.3",
  "private": true,
  "description": "A local-first Firefox extension permission and change monitor.",
  "license": "MPL-2.0",
  "scripts": {
    "build": "web-ext build --source-dir extension --artifacts-dir artifacts --overwrite-dest",
    "lint": "web-ext lint --source-dir extension",
    "start": "web-ext run --source-dir extension",
    "test": "npm run test:static && npm run test:classifier",
    "test:static": "python3 -m unittest discover -s tests -v",
    "test:classifier": "node --test \"tests/*.test.mjs\""
  },
  "devDependencies": {
    "web-ext": "10.5.0"
  },
  "engines": {
    "node": ">=22"
  }
}
